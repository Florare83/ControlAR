# Agregar al .env del BACKEND (no se sube a git)

# --- Opción A (recomendada en Render): API HTTPS de Brevo ---------------------
# Los servicios GRATUITOS de Render bloquean los puertos SMTP (25/465/587), por
# eso el envío por SMTP queda esperando y falla a los 15 segundos. La API de
# Brevo usa HTTPS y funciona igual en el plan gratuito.
#   1) Crear cuenta en https://app.brevo.com
#   2) Settings > SMTP & API > API Keys > generar una clave (empieza con xkeysib-)
#   3) Settings > Senders: agregar y VERIFICAR el correo remitente
BREVO_API_KEY=xkeysib-tu-clave
SMTP_FROM=tucuenta@gmail.com        # debe ser el remitente verificado en Brevo
SMTP_FROM_NAME=ControlAR

# --- Opción B: SMTP directo (sirve en tu PC o en un plan pago de Render) ------
# Si BREVO_API_KEY está definida, estas variables de SMTP_HOST/USER/PASSWORD se ignoran.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls      # starttls (587) | ssl (465) | none
SMTP_USER=tucuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
