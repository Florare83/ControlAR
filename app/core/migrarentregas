# Prepara una base de datos que YA existe para la Entrega 5. Se puede correr las veces
# que quieras: si no hay nada para cambiar, no hace nada.
#   1) Agrega la columna usuarios.es_operador (rol del voluntario).
#   2) Si la tabla "prestamos" tiene el diseño anterior (titulo_juego / devuelto), la
#      renombra a "prestamos_anterior" para NO perder los datos; crear_tablas crea la nueva.
# Debe correr ANTES de crear_tablas:  python -m app.core.migrar_entrega5
from sqlalchemy import inspect, text

from app.core.db import engine

insp = inspect(engine)
tablas = insp.get_table_names()

with engine.begin() as conexion:
    if "usuarios" in tablas:
        columnas = [c["name"] for c in insp.get_columns("usuarios")]
        if "es_operador" not in columnas:
            conexion.execute(
                text("ALTER TABLE usuarios ADD COLUMN es_operador BOOLEAN NOT NULL DEFAULT FALSE")
            )
            print("usuarios: columna es_operador agregada.")
        else:
            print("usuarios: ya tiene es_operador, nada para hacer.")

    if "prestamos" in tablas:
        columnas = [c["name"] for c in insp.get_columns("prestamos")]
        if "titulo_juego" in columnas:
            # Los nombres de índice son únicos en toda la base: se liberan para la tabla nueva.
            conexion.execute(text("DROP INDEX IF EXISTS ix_prestamos_id"))
            conexion.execute(text("DROP INDEX IF EXISTS ix_prestamos_dni"))
            conexion.execute(text("ALTER TABLE prestamos RENAME TO prestamos_anterior"))
            print("prestamos: tabla anterior renombrada a prestamos_anterior (datos conservados).")
        else:
            print("prestamos: ya tiene el diseño nuevo, nada para hacer.")