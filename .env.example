# --- Base de datos y seguridad ---
DATABASE_URL=postgresql://usuario:clave@localhost:5432/controlar
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Mercado Pago ---
MP_ACCESS_TOKEN=

# --- Correo, opción A (Render gratis): Brevo por HTTPS ---
BREVO_API_KEY=
SMTP_FROM=
SMTP_FROM_NAME=ControlAR


# --- Resumen de novedades automático (opcional) ---
# Si se define, un cron externo (por ejemplo cron-job.org, una vez por mes) puede mandar el
# resumen con: POST {BACKEND_URL}/suscripcion/resumen/automatico y el encabezado
# X-Cron-Clave con este mismo valor. Sin esta variable, el envío automático queda desactivado
# y el resumen se manda a mano desde el panel (Novedades).
CRON_CLAVE=
